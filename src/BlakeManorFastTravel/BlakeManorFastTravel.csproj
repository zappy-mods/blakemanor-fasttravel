<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BlakeManorFastTravel</AssemblyName>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!--
      Path to your own "The Seance of Blake Manor" install, used only to find reference
      DLLs to build against (nothing here gets copied/shipped). Never hardcode this - it's
      personal to each machine. Set it one of two ways:
        1. An environment variable named BLAKEMANOR_GAME_DIR, or
        2. dotnet build -p:GameDir="C:\path\to\The Seance of Blake Manor"
      See README.md for details.
    -->
    <GameDir Condition="'$(GameDir)' == ''">$(BLAKEMANOR_GAME_DIR)</GameDir>
    <ManagedDir>$(GameDir)/The Seance of Blake Manor_Data/Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)/BepInEx/core</BepInExCoreDir>
  </PropertyGroup>

  <Target Name="EnsureGameDirSet" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error
      Condition="'$(GameDir)' == ''"
      Text="GameDir is not set. Set the BLAKEMANOR_GAME_DIR environment variable to your game install folder, or pass -p:GameDir=&quot;C:\path\to\The Seance of Blake Manor&quot; when building. See README.md." />
  </Target>

  <ItemGroup>
    <!-- BepInEx / Harmony -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity engine -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedDir)/Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game / Adventure Creator assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SpookyDoorway.AdventureCreator">
      <HintPath>$(ManagedDir)/SpookyDoorway.AdventureCreator.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SpookyDoorway.EldritchHouse.AC">
      <HintPath>$(ManagedDir)/SpookyDoorway.EldritchHouse.AC.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EldritchHouse.Runtime">
      <HintPath>$(ManagedDir)/EldritchHouse.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.spookydoorway.scene-slinger">
      <HintPath>$(ManagedDir)/com.spookydoorway.scene-slinger.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.spookydoorway.dialogue-system">
      <HintPath>$(ManagedDir)/com.spookydoorway.dialogue-system.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
